{
    "name": "@vincenzosgueradev/pptb-agent-manifest-studio",
    "version": "0.1.0",
    "displayName": "Agent Manifest Studio",
    "description": "Preview, check and edit the Teams app package of a Copilot Studio agent before you upload it: see the icon and name as Teams shows them, validate the manifest against its JSON schema, fix problems with one click, and edit text, version, accent colour and icons with a built-in image editor. Works on a file, never on an environment.",
    "type": "module",
    "main": "index.html",
    "icon": "dist/logo.svg",
    "author": "Vincenzo Sguera",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "test": "vitest run",
        "test:full": "cross-env TEST_FULL=1 vitest run",
        "test:mutation": "node scripts/mutation-check.mjs",
        "test:watch": "vitest",
        "validate": "pptb-validate"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.0",
        "@types/node": "^26.6.5",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "cross-env": "^10.1.0",
        "jsdom": "^30.1.3",
        "tsx": "^4.19.2",
        "typescript": "^5.0.0",
        "vite": "^8.0.3",
        "vitest": "^5.0.5"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "fflate": "0.8.3"
    },
    "contributors": [
        {
            "name": "Vincenzo Sguera",
            "url": "https://github.com/vincenzosgueradev"
        }
    ],
    "keywords": [
        "pptb",
        "power-platform",
        "copilot-studio",
        "agents",
        "teams",
        "microsoft-365",
        "manifest",
        "app-package",
        "json-schema",
        "validation",
        "icon",
        "image-editor",
        "accent-colour",
        "preview"
    ],
    "configurations": {
        "repository": "https://github.com/vincenzosgueradev/agent-manifest-studio",
        "readmeUrl": "https://raw.githubusercontent.com/vincenzosgueradev/agent-manifest-studio/main/README.md",
        "website": "https://github.com/vincenzosgueradev/agent-manifest-studio",
        "category": "Copilot Studio"
    }
}
